# AniLove Backend Service - Environment Variables for Render / Node.js
# Port is automatically assigned by Render (e.g. 10000) or defaults to 3000 locally
PORT=3000

# Environment mode: 'development' or 'production'
NODE_ENV=production

# CORS allowed origins. Default is '*' which allows web browsers and Android APK WebViews (capacitor://localhost, http://localhost)
CORS_ORIGINS=*

# Optional: Google Gemini API Key for AI Anime Sensei chat assistant
GEMINI_API_KEY=
