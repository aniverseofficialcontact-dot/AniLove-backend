# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# PORT: Server port (defaults to 3000 in dev/Cloud Run, or automatically injected by Render as 10000)
PORT=3000

# NODE_ENV: 'development' or 'production'
NODE_ENV=development

# CORS_ORIGINS: Comma-separated list of allowed origins (e.g. https://my-anilove-app.vercel.app,http://localhost:5173,capacitor://localhost).
# Defaults to '*' to permit Web browsers and Android APK WebViews.
CORS_ORIGINS=*

# Frontend environment variable to point client to an external Render backend (for APK or static hosting):
VITE_API_BASE_URL=
